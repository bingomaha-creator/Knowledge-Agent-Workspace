      "id": "bug-vue-sse-event-buffer",
      "sourceProjectRef": "project-vue",
      "scope": "project",
      "reviewStatus": "confirmed",
      "title": "SSE 网络分片被当成完整事件解析",
      "symptom": "聊天流式回答一直显示正在输出，刷新页面后才出现完整内容；控制台偶发 SyntaxError: Unexpected end of JSON input。",
      "errorSignatures": ["SyntaxError: Unexpected end of JSON input"],
      "reproductionSteps": ["让服务端把一个 SSE event 拆成多个网络 chunk", "连续读取响应并直接解析每个 chunk"],
      "context": {
        "language": "TypeScript",
        "framework": "Vue",
        "versions": ["3.5.13"],
        "module": "chat-stream",
        "environment": "Browser Fetch ReadableStream"
      },
      "resolutionType": "root_cause_fix",
      "rootCause": "ReadableStream 的网络 chunk 边界与 SSE event 边界不一致，客户端在事件尚未接收完整时就执行 JSON.parse。",
      "fix": "保留 remainder 缓冲区，只按空行分隔完整 SSE event block；拼接同一事件的 data 行后再执行 JSON.parse。",
      "workaroundRisks": [],
      "applicability": ["浏览器 Fetch 流式读取 text/event-stream"],
      "verification": "覆盖单事件跨 chunk、多事件同 chunk、多 data 行和尾部残片的协议测试均通过。",
      "tags": ["vue", "sse", "streaming", "json-parse"],
      "sourceRefs": ["server/sse-utils.js", "src/features/chat/api.test.ts"]
    },
