QWEN_API_KEY=your_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_CONTEXT_WINDOW_TOKENS=32768
QWEN_EMBEDDING_MODEL=text-embedding-v3
# 瞬时错误的额外尝试次数（0..2）
QWEN_MAX_RETRIES=1
# 例：{"qwen-plus":{"inputPerMillion":0.8,"outputPerMillion":2}}
QWEN_PRICING_JSON=
# 只允许覆盖 general/documents/code/research，字段会被服务端校验
AGENT_PRESETS_JSON=

# 可选的 Node 受控联网检索 provider；Python Sidecar 的搜索配置在其服务环境中管理
RESEARCH_WEB_SEARCH_ENDPOINT=
RESEARCH_WEB_SEARCH_API_KEY=
# 逗号分隔的精确 host；留空时只允许 endpoint 自身 host
RESEARCH_WEB_SEARCH_ALLOWED_HOSTS=

# 深度研究使用 Python Sidecar；GraphRAG 还需启动 Neo4j
RESEARCH_SIDECAR_URL=http://127.0.0.1:8000/api/v1
RESEARCH_SIDECAR_TIMEOUT_MS=15000
RESEARCH_SIDECAR_POLL_MS=1000

SERVER_PORT=8787
HOST=127.0.0.1

# Bug 修复经验沉淀（与 Research 独立）
BUG_REVIEW_SIDECAR_URL=http://127.0.0.1:8011
BUG_REVIEW_SIDECAR_PORT=8011
# 私有仓库读取凭据，仅后端使用；也支持 GH_TOKEN
GITHUB_TOKEN=
# 可选，默认 Sidecar 下的 data 目录
# BUG_REVIEW_DATA_DIR=
