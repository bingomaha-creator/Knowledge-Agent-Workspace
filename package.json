{
  "name": "matthews-workspace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/react"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n server,react -c yellow,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace @matthews-workspace/react",
    "dev:server": "node ./server/index.js",
    "build": "npm run build --workspace @matthews-workspace/react",
    "preview": "npm run preview --workspace @matthews-workspace/react",
    "start": "node ./server/index.js",
    "test": "node --test \"server/**/*.test.js\"",
    "eval:research": "node server/regression/research/research-eval-live.js",
    "eval:ledger-report": "node server/regression/research/generate-ledger-diff-report.js",
    "test:client": "npm run test --workspace @matthews-workspace/react",
    "check:react": "npm run typecheck --workspace @matthews-workspace/react && npm run test:client && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
