{
  "name": "matthews-workspace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/react"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:vue",
    "dev:vue": "concurrently -n server,vue -c yellow,blue \"npm run dev:server\" \"npm run dev:client:vue\"",
    "dev:react": "concurrently -n server,react -c yellow,green \"npm run dev:server\" \"npm run dev:client:react\"",
    "dev:compare": "concurrently -n server,vue,react -c yellow,blue,green \"npm run dev:server\" \"npm run dev:client:vue\" \"npm run dev:client:react\"",
    "dev:client": "npm run dev:client:vue",
    "dev:client:vue": "vite",
    "dev:client:react": "npm run dev --workspace @matthews-workspace/react",
    "dev:server": "node ./server/index.js",
    "build": "npm run build:vue",
    "build:vue": "vue-tsc -b && vite build",
    "build:react": "npm run build --workspace @matthews-workspace/react",
    "preview": "npm run preview:vue",
    "preview:vue": "vite preview",
    "preview:react": "npm run preview --workspace @matthews-workspace/react",
    "start": "node ./server/index.js",
    "test": "node --test \"server/**/*.test.js\"",
    "test:client": "npm run test:vue",
    "test:vue": "vitest run --config vitest.vue.config.ts",
    "test:react": "npm run test --workspace @matthews-workspace/react",
    "check:react": "npm run typecheck --workspace @matthews-workspace/react && npm run test:react && npm run build:react"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "markdown-it": "^14.1.0",
    "multer": "^2.0.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
